# =========================================================================
# Environneent de PRODUCTION (déploiement via docker-compose.prod.yml).
# Copier en `.env` sur le serveur puis remplir les secrets.
# Rappel : en prod le compose ne surcharge que SERVE_FRONTEND et OTEL_* ;
# toutes les autres variables viennent de ce fichier.
# =========================================================================

# --- Général ---
DEBUG=True
# URL publique de l'API (utilisée par le backend). Domaine réel ou IP du VPS.
FASTAPI_URL=
# Hôte VPS (optionnel, défaut "").
VPS_HOST=
# Origine du front pour le CORS (main.py allow_origins). Même origine publique.
URL_FRONT=
# Dossier pour la distribution du front par le back
FRONTEND_DIR=/app/frontend_dist
# --- Auth / JWT ---
SECRET_KEY=            # openssl rand -hex 32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- PostgreSQL (service docker `postgres`) ---
POSTGRES_HOST=postgres
POSTGRES_USER=            # ex: user
POSTGRES_PASSWORD=        # openssl rand -hex 64
POSTGRES_DB=desc-image-ia-db
# disable = pas de TLS (réseau docker interne). Sinon: require / verify-full.
POSTGRES_SSL=disable

# --- Redis (service docker `redis`) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/1

# --- Microservices modèles (services docker, port interne 8000) ---
URL_SALESFORCE_CPU_LARGE=http://model-blip:8000/describe
URL_FLORANCE_2_LARGE=http://model-florence:8000/describe
URL_GIT_LARGE=http://model-git:8000/describe

# --- Traitement par lots ---
BATCH_SIZE=1
BATCH_MAX=200
MAX_CONCURRENT_PER_MODEL=1

# --- Observabilité OpenTelemetry → LGTM ---
# Note : le compose prod surcharge déjà OTEL_SERVICE_NAME et
# OTEL_EXPORTER_OTLP_ENDPOINT (http://lgtm:4317). Valeurs ici pour référence.
OTEL_SERVICE_NAME=desc-images-ia-backend
OTEL_RESOURCE_ATTRIBUTES=service.version=0.1.0,deployment.environment=prod
OTEL_EXPORTER_OTLP_ENDPOINT=http://lgtm:4317
OTEL_EXPORTER_OTLP_INSECURE=true
# Sampling : baisser (~0.1) si le volume de traces explose.
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

# --- Distribution du frontend par le backend ---
# Surchargé à True par le compose ; laissé ici pour cohérence.
SERVE_FRONTEND=True

# --- Grafana / stack LGTM (service docker `lgtm`) ---
# DOMAIN alimente GF_SERVER_DOMAIN (root_url /grafana/). Domaine réel ou IP.
DOMAIN=82.165.121.207
# Mot de passe admin Grafana (obligatoire, sinon vide).
GF_SECURITY_ADMIN_PASSWORD=    # openssl rand -hex 24
