DEBUG=False # Modifier en True
FASTAPI_URL=http://localhost:8000
VPS_HOST=

SECRET_KEY= #openssl rand -hex 32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

POSTGRES_HOST=localhost
POSTGRES_USER=example
POSTGRES_PASSWORD= #openssl rand -hex 64
POSTGRES_DB=example

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/1

URL_SALESFORCE_CPU_LARGE=http://localhost:8001/describe
URL_FLORANCE_2_LARGE=http://localhost:8002/describe
URL_GIT_LARGE=http://localhost:8003/describe

BATCH_SIZE=1
BATCH_MAX=200
MAX_CONCURRENT_PER_MODEL=1

# --- Observabilité OpenTelemetry → LGTM (Tempo/Mimir/Loki) ---
# Identité du service (le worker surcharge OTEL_SERVICE_NAME en -worker).
OTEL_SERVICE_NAME=desc-images-ia-backend
OTEL_RESOURCE_ATTRIBUTES=service.version=0.1.0,deployment.environment=dev
# Collecteur OTLP. En local hors docker : localhost:4318. En docker-compose la
# valeur est surchargée vers http://lgtm:4318. Vers le VPS : http://82.165.121.207:4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Sampling : 100% en dev, à baisser (~0.1) en prod si le volume explose.
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

SERVE_FRONTEND=
FRONTEND_DIR=