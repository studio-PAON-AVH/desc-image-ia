DEBUG=False # Modifier en True
FASTAPI_URL=http://localhost:8000
VPS_HOST=
URL_FRONT=

SECRET_KEY= #openssl rand -hex 32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

POSTGRES_HOST=localhost
POSTGRES_USER=example
POSTGRES_PASSWORD= #openssl rand -hex 64
POSTGRES_DB=example

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/1

URL_SALESFORCE_CPU_LARGE=http://localhost:8001/describe
URL_FLORANCE_2_LARGE=http://localhost:8002/describe
URL_GIT_LARGE=http://localhost:8003/describe

BATCH_SIZE=1
BATCH_MAX=200
MAX_CONCURRENT_PER_MODEL=1

# --- Observabilité OpenTelemetry → LGTM (Tempo/Mimir/Loki) ---
# Identité du service (le worker surcharge OTEL_SERVICE_NAME en -worker).
OTEL_SERVICE_NAME=desc-images-ia-backend
OTEL_RESOURCE_ATTRIBUTES=service.version=0.1.0,deployment.environment=dev
# Collecteur OTLP gRPC. En local hors docker : localhost:4317. En docker-compose la
# valeur est surchargée vers http://lgtm:4317. Vers le VPS : http://82.165.121.207:4317
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
# Sampling : 100% en dev, à baisser (~0.1) en prod si le volume explose.
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

# --- Grafana / stack LGTM (service docker `lgtm`) ---
# DOMAIN alimente GF_SERVER_DOMAIN (root_url /grafana/). Domaine ou IP du VPS.
DOMAIN=
# Mot de passe admin Grafana (login: admin). Obligatoire, sinon vide.
GF_SECURITY_ADMIN_PASSWORD=    # openssl rand -hex 24

# --- Distribution du frontend par le backend ---
# true : le back sert le build du front sur / (mode docker-compose, tout sur :8000).
# false : API seule, le front tourne à part (Vite dev server sur :5173 en local).
SERVE_FRONTEND=false
# Dossier contenant le build Vite. En local : frontend/dist (après npm run build).
# Dans l'image Docker le défaut est /app/frontend_dist, pas besoin de le définir.
FRONTEND_DIR=frontend/dist